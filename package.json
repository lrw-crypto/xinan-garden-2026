{
  "name": "prayer-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test": "firebase emulators:exec --only auth,database --project demo-garden 'node --test tests/*.test.mjs'",
    "test:browser": "firebase emulators:exec --only auth,database --project demo-garden \"node tests/run-browser.mjs\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "firebase-tools": "^14.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0"
  }
}
